# ─────────────────────────────────────────────────────────────────────────────
# SEOSCRAPE environment configuration
#
# Copy this file to `.env` for local development:
#     cp .env.example .env
#
# On Railway, do NOT commit a .env — set each of these as service Variables.
# Real platform variables always take precedence over a local .env file.
# ─────────────────────────────────────────────────────────────────────────────

# ── Server ───────────────────────────────────────────────────────────────────
# Port the API listens on. Railway injects PORT automatically — leave unset there.
PORT=3001
# Network interface to bind. Local default is 127.0.0.1.
# Railway needs 0.0.0.0 (the Docker image already sets this for you).
HOST=127.0.0.1

# ── API authentication ───────────────────────────────────────────────────────
# Set API_KEY to protect the write/data endpoints. When API_KEY is set, auth is
# automatically required. This same key is used as the dashboard password.
# Use a long random string, e.g.: openssl rand -hex 32
API_KEY=

# Force authentication even if API_KEY is empty (optional; usually leave false).
REQUIRE_API_KEY=false

# ── Domain allowlist ─────────────────────────────────────────────────────────
# true  = accept any public host (loopback / private IPs are always blocked).
# false = only accept hosts listed in ALLOWED_DOMAINS.
ALLOW_ALL_DOMAINS=true

# Comma-separated hostnames, used only when ALLOW_ALL_DOMAINS=false.
# Subdomains of these are also accepted (e.g. cdn.example.com for example.com).
ALLOWED_DOMAINS=example.com,www.example.com

# ── Output storage ───────────────────────────────────────────────────────────
# Where rendered HTML and downloaded images are written. Served under /files/.
# Railway: point this at a mounted volume so runs survive redeploys,
# e.g. OUTPUT_DIR=/data/output
OUTPUT_DIR=output

# ── Collections & pagination ─────────────────────────────────────────────────
# Max number of products scraped from a collection (across all crawled pages).
MAX_COLLECTION_PRODUCTS=100
# Default number of listing pages to walk (overridable per request via maxPages).
MAX_COLLECTION_PAGES=10
# Hard ceiling for a per-request maxPages override.
MAX_COLLECTION_PAGES_CEILING=100

# ── Scraping performance ────────────────────────────────────────────────────
# Parallel collection/product scraping. Match this to the box size.
SCRAPE_CONCURRENCY=4
# Parallel image downloads per product.
IMAGE_CONCURRENCY=4
# Auto-scroll budget for product pages (short; they usually settle quickly).
PRODUCT_SCROLL_TIMEOUT_MS=5000
# Auto-scroll budget for listing/collection pages (long; lazy grids need it).
LISTING_SCROLL_TIMEOUT_MS=15000

# ── Headless browser stability (prevents SIGTRAP / OOM crashes) ──────────────
# Max headless Chromium processes alive at once across ALL requests. Keep low on
# small containers — unbounded concurrent launches OOM-kill the box. Default 1.
BROWSER_MAX_CONCURRENCY=1
# Per-attempt timeout for launching Chromium before we retry (ms).
BROWSER_LAUNCH_TIMEOUT_MS=45000
# Bandwidth saver: drop image/media/font requests in the headless browser. SEO
# and rank extraction never use the rendered pixels (it reads the DOM/HTML), so
# this cuts proxy bytes ~70-90%. Default true. Set false only to debug.
BLOCK_BROWSER_ASSETS=true
# More aggressive: also drop stylesheets. Off by default — a few themes use
# layout/visibility checks to trigger lazy-loading, so this can change what
# content appears. Enable only if your stores render fine without it.
BLOCK_BROWSER_STYLESHEETS=false

# ── Anti-blocking / Cloudflare bypass ────────────────────────────────────────
# The single most reliable way past Cloudflare IP blocks is a residential or
# rotating proxy. When set, ALL scraping (headless browser + plain fetch) routes
# through it. Leave empty to scrape direct (stealth + realistic headers still
# apply and lower the block rate, but datacenter IPs are blocked more often).
# Format: http://user:pass@host:port  (or socks5://host:port)
#
# This is the DEFAULT proxy. A request may override it per-call with a `proxy`
# field in the JSON body (e.g. the customer's own proxy) — see API.md. Per-request
# proxies never appear in logs (creds are redacted).
SCRAPE_PROXY_URL=
# Alternatively, split the credentials out of the URL:
# SCRAPE_PROXY_USERNAME=
# SCRAPE_PROXY_PASSWORD=

# ── Best-seller enrichment ───────────────────────────────────────────────────
# How many product pages to scrape in parallel during opt-in tracker enrichment.
ENRICH_CONCURRENCY=2

# ── Database (listing rank tracker) ──────────────────────────────────────────
# Postgres connection string. On Railway, reference the Postgres plugin's
# variable: ${{ Postgres.DATABASE_URL }}. Leave empty to disable the listing
# tracker endpoints (the product/collection checker still works without it).
# For an external/public Postgres URL you may need to append ?sslmode=require.
DATABASE_URL=

# ── Accounts / dashboard ─────────────────────────────────────────────────────
# Enforce API-key auth on the scrape endpoints. With accounts in use, set true so
# only valid per-account keys (or the API_KEY admin backdoor below) are accepted.
REQUIRE_API_KEY=false
# Optional operator/admin backdoor key (accepted in addition to per-account keys).
API_KEY=
# REQUIRED in production for accounts. Signs the HMAC segments of API keys —
# changing it invalidates all issued keys. Use a long random string.
API_KEY_HMAC_SECRET=
# REQUIRED in production for accounts. Encrypts customers' stored proxies at rest
# (AES-256-GCM). Changing it makes existing stored proxies unreadable. Long random.
SECRET_ENCRYPTION_KEY=
# Bootstrap admin, created once on first boot if it doesn't exist. After that,
# create users via POST /api/admin/users (no open signup). Unset to skip seeding.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Session cookie behaviour. Default secure + SameSite=None suits a frontend on a
# different domain than the backend (cross-site). For a same-origin setup you may
# use COOKIE_SAMESITE=lax. Set COOKIE_SECURE=false ONLY for local http testing.
# COOKIE_SECURE=true
# COOKIE_SAMESITE=none

# ── Billing (Polar) ──────────────────────────────────────────────────────────
# Public URL of the frontend, used to build checkout success/return URLs.
FRONTEND_PUBLIC_URL=
# Polar API token + webhook signing secret (whsec_...). The webhook is REJECTED
# when the secret is unset, so set it in production.
POLAR_ACCESS_TOKEN=
POLAR_WEBHOOK_SECRET=
# Product IDs from your Polar dashboard, mapped to plans + top-up packs.
POLAR_STARTER_PRODUCT_ID=
POLAR_PRO_PRODUCT_ID=
POLAR_SCALE_PRODUCT_ID=
POLAR_TOPUP_500_PRODUCT_ID=
POLAR_TOPUP_2500_PRODUCT_ID=
POLAR_TOPUP_10000_PRODUCT_ID=
# Pre-launch early access: a $5 one-time product. Create it in Polar and paste the
# id here. Buyers check out anonymously; the webhook records their email in
# early_access_signups for onboarding at launch. Leave empty to disable the offer.
POLAR_EARLY_ACCESS_PRODUCT_ID=

# ── Rate limiting (per minute, per credential then per IP) ────────────────────
# Optional overrides; sensible defaults apply when unset.
# RATE_LIMIT_GLOBAL_MAX=600
# RATE_LIMIT_LOGIN_MAX=10
# RATE_LIMIT_SCRAPE_MAX=120
