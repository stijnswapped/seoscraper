# Frontend build-time configuration (Vite inlines VITE_* at build time).
#
# Local dev: leave this UNSET. Requests use relative paths and Vite's dev proxy
# (vite.config.ts) forwards them to the backend at http://127.0.0.1:3001.
#
# Deployed (Railway): set this to the backend's PUBLIC domain so the browser can
# reach it directly. Do NOT use the private *.railway.internal address — a
# browser cannot resolve it.
#   VITE_API_BASE_URL=https://seoscrapebackend-production.up.railway.app
VITE_API_BASE_URL=
