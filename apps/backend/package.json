{
  "name": "@seoscrape/backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:host": "HOST=0.0.0.0 tsx src/index.ts",
    "start": "tsx src/index.ts",
    "start:host": "HOST=0.0.0.0 tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "db:migrate": "tsx src/db/migrate.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/cookie": "^9.4.0",
    "@fastify/cors": "^9.0.1",
    "@fastify/static": "^7.0.4",
    "cheerio": "^1.0.0",
    "dotenv": "^16.6.1",
    "fastify": "^4.28.1",
    "pg": "^8.13.1",
    "playwright": "^1.48.0",
    "sharp": "^0.33.5",
    "undici": "^6.26.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4",
    "vitest": "^2.1.0"
  }
}
